DEEPSEEK_API_KEY=replace_me
DEEPSEEK_MODEL=deepseek-v4-flash
DATABASE_PATH=/data/moderation.db
REVIEW_TIMEOUT_MINUTES=4320

SMOKING_BOT_TOKEN=replace_me
SMOKING_ADMIN_ID=123456789
DRINKING_BOT_TOKEN=replace_me
DRINKING_ADMIN_ID=123456789

# Keep this JSON on one line in Railway.
BOTS_CONFIG_JSON=[{"name":"smoking","token_env":"SMOKING_BOT_TOKEN","admin_id_env":"SMOKING_ADMIN_ID","default_profile":"quit_smoking","chat_profiles":{}},{"name":"drinking","token_env":"DRINKING_BOT_TOKEN","admin_id_env":"DRINKING_ADMIN_ID","default_profile":"quit_drinking","chat_profiles":{}}]

# Optional: define/replace all profiles from a Railway variable instead of profiles.json.
# PROFILES_JSON={"my_business":{"moderation_mode":"custom","system_prompt":"...","welcome_trigger":"+","welcome_message":"...","keywords":[]}}


